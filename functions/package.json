{
  "name": "@solvesphere/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc && node ../scripts/bundle-functions.mjs",
    "watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "gcp-build": "",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
