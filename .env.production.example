# ==============================================================================
# SolveSphere AI — Production Environment Configuration (.env.production.example)
# Application: SolveSphere AI
# Tagline: Your Problems. Our Smart Solutions.
# Target Project: solvesphere-ai-prod
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Client Configuration (Vite)
# ------------------------------------------------------------------------------
# In Production, connect exclusively to live Google Cloud & Firebase Production infrastructure
VITE_USE_FIREBASE_EMULATOR=false

# Firebase Production Web App Credentials (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="AIzaSyProductionClientApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="solvesphere-ai-prod.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="solvesphere-ai-prod"
VITE_FIREBASE_STORAGE_BUCKET="solvesphere-ai-prod.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="102938475610"
VITE_FIREBASE_APP_ID="1:102938475610:web:prodabcdef123456"

# ------------------------------------------------------------------------------
# 2. Cloud Functions & GCP Secret Manager
# ------------------------------------------------------------------------------
# In production, GEMINI_API_KEY MUST NOT be stored in environment variables.
# It is provisioned exclusively through Google Cloud Secret Manager:
#   firebase functions:secrets:set GEMINI_API_KEY
# Verified models:
GCLOUD_PROJECT="solvesphere-ai-prod"
FIREBASE_PROJECT_ID="solvesphere-ai-prod"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# ------------------------------------------------------------------------------
# 3. Administrative Initial Bootstrap (Executed once per production cluster)
# ------------------------------------------------------------------------------
# Provision through scripts/bootstrap-admin.js with high-entropy credentials
# stored in campus enterprise secrets manager (e.g., Vault / AWS Secrets Manager / 1Password)
ADMIN_EMAIL="admin@campus.edu"
ADMIN_PASSWORD="ReplaceWithProductionHighEntropyPassword"
ADMIN_NAME="Lead Campus Administrator"
