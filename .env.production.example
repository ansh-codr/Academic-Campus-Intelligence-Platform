# ==============================================================================
# SolveSphere AI — Production Environment Configuration (.env.production.example)
# Application: SolveSphere AI
# Tagline: Your Problems. Our Smart Solutions.
# Target Project Placeholder: <YOUR_PRODUCTION_FIREBASE_PROJECT_ID>
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Client Configuration (Vite)
# ------------------------------------------------------------------------------
# In Production, connect exclusively to live Google Cloud & Firebase Production infrastructure
VITE_USE_FIREBASE_EMULATOR=false

# Firebase Production Web App Credentials (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="<YOUR_PRODUCTION_FIREBASE_API_KEY>"
VITE_FIREBASE_AUTH_DOMAIN="<YOUR_PRODUCTION_PROJECT_ID>.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="<YOUR_PRODUCTION_FIREBASE_PROJECT_ID>"
VITE_FIREBASE_STORAGE_BUCKET="<YOUR_PRODUCTION_PROJECT_ID>.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="<YOUR_PRODUCTION_SENDER_ID>"
VITE_FIREBASE_APP_ID="<YOUR_PRODUCTION_APP_ID>"

# ------------------------------------------------------------------------------
# 2. Cloud Functions & GCP Secret Manager
# ------------------------------------------------------------------------------
# In production, GEMINI_API_KEY MUST NOT be stored in plaintext environment variables.
# It is provisioned exclusively through Google Cloud Secret Manager via Firebase CLI:
#   firebase functions:secrets:set GEMINI_API_KEY
# Verified models:
GCLOUD_PROJECT="<YOUR_PRODUCTION_FIREBASE_PROJECT_ID>"
FIREBASE_PROJECT_ID="<YOUR_PRODUCTION_FIREBASE_PROJECT_ID>"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# ------------------------------------------------------------------------------
# 3. Administrative Initial Bootstrap (Executed once per production cluster)
# ------------------------------------------------------------------------------
# Privileged account creation in production requires deliberate authorization:
# Set CONFIRM_PROD_ADMIN_BOOTSTRAP="true" when executing scripts/bootstrap-admin.js.
# Supply high-entropy credentials securely from an institutional password manager
# or secrets vault (e.g., Google Cloud Secret Manager, HashiCorp Vault, 1Password).
CONFIRM_PROD_ADMIN_BOOTSTRAP="false"
ADMIN_EMAIL="<PRODUCTION_CAMPUS_ADMIN_EMAIL>"
ADMIN_PASSWORD="<REPLACE_WITH_HIGH_ENTROPY_PASSWORD_MIN_16_CHARS>"
ADMIN_NAME="<LEAD_CAMPUS_ADMINISTRATOR_NAME>"
