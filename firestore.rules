rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // User can read their own profile; admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      // User can create their profile on registration with STUDENT role
      allow create: if isOwner(userId) && request.resource.data.role == 'STUDENT';
      // User can update non-privileged fields (bio, phone, department, semester)
      // Cannot alter role or id
      allow update: if isOwner(userId) 
        && request.resource.data.role == resource.data.role
        && request.resource.data.id == resource.data.id;
      // Admins have full access
      allow update, delete: if isAdmin();
    }

    // Complaints / Maintenance Tickets
    match /complaints/{complaintId} {
      // Students can read their own complaints; Admins can read all complaints
      allow read: if (isAuthenticated() && resource.data.submittedById == request.auth.uid) || isAdmin();
      
      // Students can create complaints owned by them, initial status must be SUBMITTED
      allow create: if isAuthenticated() 
        && request.resource.data.submittedById == request.auth.uid
        && request.resource.data.status == 'SUBMITTED';

      // Updates: only Admin can change status or department assignment
      // (or performed via Cloud Functions Admin SDK)
      allow update, delete: if isAdmin();

      // Subcollection: timeline events
      match /timeline/{eventId} {
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/complaints/$(complaintId)).data.submittedById == request.auth.uid) || isAdmin();
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/complaints/$(complaintId)).data.submittedById == request.auth.uid || isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    // Top-level ticketEvents (audit trail)
    match /ticketEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Academic Subjects
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Syllabus Topics
    match /syllabusTopics/{topicId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Study Resources
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Practice / Quizzes
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow read, create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Campus Departments
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Issue Clusters (Semantic groupings)
    match /issueClusters/{clusterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Campus Clubs
    match /campusClubs/{clubId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, delete: if isAdmin();
    }

    // Speak Freely (Anonymous Reports - isolated preview)
    match /anonymousReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
