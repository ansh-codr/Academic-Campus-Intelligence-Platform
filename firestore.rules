rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    // Students can only update non-privileged profile fields.
    // Initial student ID can be provisioned once during profile completion (e.g. after Google sign-in);
    // once set, student ID, account ID, role, email, and authorization claims are strictly immutable.
    function isAllowedProfileUpdate() {
      let canSetStudentId = !('studentId' in resource.data) || resource.data.studentId == null || resource.data.studentId == '';
      let allowedKeys = canSetStudentId 
        ? ['displayName', 'fullName', 'phoneNumber', 'photoURL', 'avatarUrl', 'bio', 'department', 'semester', 'studentId', 'updatedAt']
        : ['displayName', 'fullName', 'phoneNumber', 'photoURL', 'avatarUrl', 'bio', 'department', 'semester', 'updatedAt'];
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(allowedKeys)
        && request.resource.data.role == resource.data.role
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && (!('studentId' in resource.data) || resource.data.studentId == null || resource.data.studentId == '' || request.resource.data.studentId == resource.data.studentId)
        && !('customClaims' in request.resource.data);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // User can read their own profile; admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();
      // User can create their profile on registration with STUDENT role only; ID must match auth UID
      allow create: if isOwner(userId) 
        && request.resource.data.role == 'STUDENT'
        && request.resource.data.id == userId
        && !('customClaims' in request.resource.data);
      // User can update non-privileged fields only; cannot alter registered student ID, role, id, email, or emailVerified
      allow update: if isOwner(userId) && isAllowedProfileUpdate();
      // Admins have full access
      allow update, delete: if isAdmin();
    }

    // Complaints / Maintenance Tickets
    match /complaints/{complaintId} {
      // Students can read their own complaints; Admins can read all complaints
      allow read: if (isAuthenticated() && resource.data.submittedById == request.auth.uid) || isAdmin();
      
      // Direct client creation is disabled. All complaints MUST be created via the trusted Cloud Function
      // which enforces ownership, validation, atomic SS-2026-XXXX sequence numbering, and initial timeline creation.
      allow create: if false;

      // Updates and deletions: only Admin can change status or department assignment
      // (or performed via Cloud Functions Admin SDK)
      allow update, delete: if isAdmin();

      // Subcollection: timeline events (official lifecycle state transitions, written strictly by Admin SDK / Cloud Functions)
      match /timeline/{eventId} {
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/complaints/$(complaintId)).data.submittedById == request.auth.uid) || isAdmin();
        // Restrict forged ticket lifecycle events: direct client creation/update is blocked
        allow write: if isAdmin();
      }
    }

    // Top-level ticketEvents (audit trail - restricted to administrators or authorized ticket owners)
    match /ticketEvents/{eventId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.submittedById == request.auth.uid);
      allow write: if isAdmin();
    }

    // Academic Subjects
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Syllabus Topics
    match /syllabusTopics/{topicId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Study Resources
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Practice / Quizzes
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // Protected Question Bank (prevents pre-submission answer leakage)
      match /questions/{questionId} {
        allow read, write: if isAdmin();
      }
    }

    // Quiz Attempts (Official Audited Records - writes strictly restricted to trusted Admin/Cloud Functions SDK)
    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Student Study Progress (Personal Topic Checklist)
    match /studentStudyProgress/{progressId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // StudyMate Conversations & Messages (Student Chat Isolation)
    match /studyMateConversations/{conversationId} {
      allow read, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/studyMateConversations/$(conversationId)).data.userId == request.auth.uid || isAdmin()
        );
        // Restrict forged chat messages: Messages are written strictly by trusted Cloud Functions Admin SDK.
        allow write: if isAdmin();
      }
    }

    // AI Usage Quotas & Rate Limiting (Managed only by Cloud Functions)
    match /aiUsage/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Campus Care AI Conversations & Messages (Student Chat Isolation)
    match /campusCareConversations/{conversationId} {
      allow read, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/campusCareConversations/$(conversationId)).data.userId == request.auth.uid || isAdmin()
        );
        // Restrict forged chat messages: Messages are written strictly by trusted Cloud Functions Admin SDK.
        allow write: if isAdmin();
      }
    }

    // Complaint Embeddings Cache (Restricted strictly to Cloud Functions / Admins)
    match /complaintEmbeddings/{complaintId} {
      allow read, write: if isAdmin();
    }

    // Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Campus Departments
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Issue Clusters (Raw internal operational clusters - restricted strictly to Admins)
    match /issueClusters/{clusterId} {
      allow read, write: if isAdmin();
    }

    // Cluster Coordination (Internal background coordination - Admins only, client writes disabled)
    match /clusterCoordination/{coordId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Public/Student Sanitized Active Campus Incidents (Contains no student IDs or individual complaint references)
    match /publicIncidents/{incidentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Campus Clubs
    match /campusClubs/{clubId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    // Speak Freely (Anonymous Reports - live client writes disabled pending zero-knowledge architecture)
    match /anonymousReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
