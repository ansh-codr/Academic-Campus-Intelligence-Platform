# ==============================================================================
# SolveSphere AI — Staging Environment Configuration (.env.staging.example)
# Application: SolveSphere AI
# Tagline: Your Problems. Our Smart Solutions.
# Target Project: solvesphere-ai-staging
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Client Configuration (Vite)
# ------------------------------------------------------------------------------
# In Staging, connect directly to live Cloud Firebase Staging services
VITE_USE_FIREBASE_EMULATOR=false

# Firebase Staging Web App Credentials (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="AIzaSyStagingClientApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="solvesphere-ai-staging.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="solvesphere-ai-staging"
VITE_FIREBASE_STORAGE_BUCKET="solvesphere-ai-staging.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="987654321098"
VITE_FIREBASE_APP_ID="1:987654321098:web:stagingabcdef123456"

# ------------------------------------------------------------------------------
# 2. Cloud Functions & GCP Secret Manager
# ------------------------------------------------------------------------------
# Production & Staging Cloud Functions bind GEMINI_API_KEY securely via:
#   firebase functions:secrets:set GEMINI_API_KEY
# Cloud Functions retrieve this via defineSecret('GEMINI_API_KEY')
GCLOUD_PROJECT="solvesphere-ai-staging"
FIREBASE_PROJECT_ID="solvesphere-ai-staging"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# ------------------------------------------------------------------------------
# 3. Administrative Account Provisioning (Controlled CI/CD execution)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="staging-admin@campus.edu"
ADMIN_PASSWORD="ReplaceWithStagingPasswordFromVault"
ADMIN_NAME="Staging Administrator"
