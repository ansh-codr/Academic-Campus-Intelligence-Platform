# ==============================================================================
# SolveSphere AI — Staging Environment Configuration (.env.staging.example)
# Application: SolveSphere AI
# Tagline: Your Problems. Our Smart Solutions.
# Target Project Placeholder: <YOUR_STAGING_FIREBASE_PROJECT_ID>
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Client Configuration (Vite)
# ------------------------------------------------------------------------------
# In Staging, connect directly to live Cloud Firebase Staging services
VITE_USE_FIREBASE_EMULATOR=false

# Firebase Staging Web App Credentials (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY="<YOUR_STAGING_FIREBASE_API_KEY>"
VITE_FIREBASE_AUTH_DOMAIN="<YOUR_STAGING_PROJECT_ID>.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="<YOUR_STAGING_FIREBASE_PROJECT_ID>"
VITE_FIREBASE_STORAGE_BUCKET="<YOUR_STAGING_PROJECT_ID>.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="<YOUR_STAGING_SENDER_ID>"
VITE_FIREBASE_APP_ID="<YOUR_STAGING_APP_ID>"

# ------------------------------------------------------------------------------
# 2. Cloud Functions & GCP Secret Manager
# ------------------------------------------------------------------------------
# Staging & Production Cloud Functions bind GEMINI_API_KEY securely via:
#   firebase functions:secrets:set GEMINI_API_KEY
# Cloud Functions retrieve this via defineSecret('GEMINI_API_KEY')
GCLOUD_PROJECT="<YOUR_STAGING_FIREBASE_PROJECT_ID>"
FIREBASE_PROJECT_ID="<YOUR_STAGING_FIREBASE_PROJECT_ID>"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# ------------------------------------------------------------------------------
# 3. Administrative Account Provisioning (Controlled CI/CD execution)
# ------------------------------------------------------------------------------
# Production and staging administrator creation requires deliberate authorization:
# CONFIRM_PROD_ADMIN_BOOTSTRAP must be set to "true" to authorize live provisioning.
CONFIRM_PROD_ADMIN_BOOTSTRAP="false"
ADMIN_EMAIL="<STAGING_ADMIN_EMAIL_ADDRESS>"
ADMIN_PASSWORD="<REPLACE_WITH_HIGH_ENTROPY_PASSWORD_MIN_16_CHARS>"
ADMIN_NAME="Staging Administrator"
