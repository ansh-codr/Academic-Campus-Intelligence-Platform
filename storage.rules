rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Ticket Complaint Attachments (Strict owner isolation; legacy unvalidated complaint paths removed)
    match /attachments/{userId}/{ticketId}/{fileName} {
      // Authorized ticket owner or administrator only
      allow read: if isOwner(userId) || isAdmin();
      
      // Upload rules: owner only, size < 10MB, strictly restricted image/pdf MIME types
      allow create: if isOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');

      // Deletion rules: authorized owner or administrator only
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Official Academic Resources (read-only for students, upload for admin)
    match /academic-resources/{subjectId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
