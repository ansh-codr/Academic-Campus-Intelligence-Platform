# ==============================================================================
# SolveSphere AI — Local Development Environment Configuration (.env.example)
# Application: SolveSphere AI
# Tagline: Your Problems. Our Smart Solutions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Set to 'true' to connect the web app directly to local Firebase Emulators:
# Auth: 9099, Firestore: 8080, Functions: 5001, Storage: 9199, Hosting: 5000
VITE_USE_FIREBASE_EMULATOR=true

# Firebase Web App Credentials (local emulator placeholders or dev project)
VITE_FIREBASE_API_KEY="<FIREBASE_WEB_API_KEY_FROM_CONSOLE>"
VITE_FIREBASE_AUTH_DOMAIN="solvesphere-ai-dev-2026.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="solvesphere-ai-dev-2026"
VITE_FIREBASE_STORAGE_BUCKET="solvesphere-ai-dev-2026.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="445610047961"
VITE_FIREBASE_APP_ID="1:445610047961:web:068cf60c3d2d01c16e81c8"

# ------------------------------------------------------------------------------
# 2. Cloud Functions & Backend Runtime
# ------------------------------------------------------------------------------
GCLOUD_PROJECT="solvesphere-ai-dev-2026"
FIREBASE_PROJECT_ID="solvesphere-ai-dev-2026"

# Gemini AI Models (2nd Gen Functions & Google Gen AI SDK)
# In local development without live keys, functions safely mock AI responses.
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
# Set GEMINI_API_KEY only when testing live API calls locally (do NOT commit real keys)
# GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Administrative Bootstrap Account
# ------------------------------------------------------------------------------
ADMIN_EMAIL="<INSTITUTION_ADMIN_EMAIL>"
ADMIN_PASSWORD="<GENERATE_DEV_ADMIN_PASSWORD_MIN_12_CHARS>"
ADMIN_NAME="<INSTITUTION_ADMIN_DISPLAY_NAME>"
