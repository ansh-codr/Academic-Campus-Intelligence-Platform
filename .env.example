# ==============================================================================
# SolveSphere AI — Environment Variables Template (Phase 2 Firebase Platform)
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# In development, VITE_USE_FIREBASE_EMULATOR=true connects the web app directly
# to the local Firebase Emulator Suite (Auth: 9099, Firestore: 8080, Functions: 5001, Storage: 9199).
VITE_USE_FIREBASE_EMULATOR=true

# Firebase Web App Credentials (found in Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="solvesphere-ai-dev.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="solvesphere-ai-dev"
VITE_FIREBASE_STORAGE_BUCKET="solvesphere-ai-dev.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# ------------------------------------------------------------------------------
# Backend & Cloud Functions Configuration
# ------------------------------------------------------------------------------
GCLOUD_PROJECT="solvesphere-ai-dev"

# Administrative Provisioning Tool (scripts/bootstrap-admin.js)
ADMIN_EMAIL="admin@campus.edu"
ADMIN_PASSWORD="YourSecureAdminPasswordHere"
ADMIN_NAME="Dr. Vikram Malhotra"

# ------------------------------------------------------------------------------
# Future AI Integration (Phase 3)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=""
