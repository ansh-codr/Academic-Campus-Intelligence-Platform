// ==============================================================================
// SolveSphere AI - Preliminary Database Schema (Phase 1)
// Target Database: PostgreSQL
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  FACULTY
  ADMIN
}

enum TopicStatus {
  COMPLETED
  ONGOING
  UPCOMING
}

enum ResourceScope {
  WITHIN_SYLLABUS
  OUTSIDE_SYLLABUS
}

enum ResourceType {
  PDF
  VIDEO
  SLIDES
  NOTE
  PRACTICE_SHEET
}

enum TicketCategory {
  AC_HVAC
  WIFI_NETWORK
  ELECTRICAL
  HOSTEL
  WATER_SUPPLY
  GENERAL_INFRASTRUCTURE
  SANITATION
}

enum TicketStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ClubCategory {
  TECHNOLOGY
  CULTURE
  SPORTS
  LITERARY
  ENTREPRENEURSHIP
}

// ------------------------------------------------------------------------------
// Identity & Access Management
// ------------------------------------------------------------------------------

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  studentId    String?        @unique
  passwordHash String
  fullName     String
  role         UserRole       @default(STUDENT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  profile      Profile?
  enrollments  Enrollment[]
  complaints   Complaint[]
  ticketEvents TicketEvent[]
  quizAttempts QuizAttempt[]
  notifications Notification[]

  @@map("users")
}

model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String?
  semester   Int?
  avatarUrl  String?
  bio        String?
  phone      String?

  @@map("profiles")
}

// ------------------------------------------------------------------------------
// Module A: Academic Intelligence Models
// ------------------------------------------------------------------------------

model Subject {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  credits     Int             @default(3)
  instructor  String
  createdAt   DateTime        @default(now())

  topics      SyllabusTopic[]
  resources   Resource[]
  enrollments Enrollment[]
  quizzes     Quiz[]

  @@map("subjects")
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  subjectId  String
  enrolledAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("enrollments")
}

model SyllabusTopic {
  id             String      @id @default(uuid())
  subjectId      String
  unit           Int
  title          String
  description    String
  order          Int
  status         TopicStatus @default(UPCOMING)
  estimatedHours Int?
  completedAt    DateTime?
  isCurrent      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  subject        Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  resources      Resource[]

  @@map("syllabus_topics")
}

model Resource {
  id              String        @id @default(uuid())
  subjectId       String
  topicId         String?
  title           String
  description     String
  scope           ResourceScope @default(WITHIN_SYLLABUS)
  type            ResourceType  @default(PDF)
  facultyApproved Boolean       @default(false)
  authorFaculty   String?
  fileUrl         String?
  downloadCount   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic           SyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@map("resources")
}

model Quiz {
  id              String        @id @default(uuid())
  subjectId       String
  title           String
  durationMinutes Int           @default(15)
  createdAt       DateTime      @default(now())

  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions       Question[]
  attempts        QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id                 String   @id @default(uuid())
  quizId             String
  questionText       String
  options            String[]
  correctOptionIndex Int
  explanation        String?

  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int
  totalScore  Int
  completedAt DateTime @default(now())

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

// ------------------------------------------------------------------------------
// Module B: Campus Intelligence Models
// ------------------------------------------------------------------------------

model Department {
  id          String       @id @default(uuid())
  name        String       @unique
  code        String       @unique
  contactEmail String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  tickets     Complaint[]

  @@map("departments")
}

model IssueCluster {
  id              String         @id @default(uuid())
  title           String
  category        TicketCategory
  affectedArea    String
  confidenceScore Float          @default(0.85)
  status          String         @default("ACTIVE_INCIDENT")
  suggestedAction String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tickets         Complaint[]

  @@map("issue_clusters")
}

model Complaint {
  id             String          @id @default(uuid())
  referenceNumber String         @unique
  title          String
  category       TicketCategory
  building       String
  floor          String
  room           String
  description    String
  priority       TicketPriority  @default(MEDIUM)
  status         TicketStatus    @default(SUBMITTED)
  departmentId   String?
  submittedById  String
  clusterId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  submittedBy    User            @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  cluster        IssueCluster?   @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  attachments    ComplaintAttachment[]
  timelineEvents TicketEvent[]

  @@map("complaints")
}

model ComplaintAttachment {
  id          String    @id @default(uuid())
  complaintId String
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  uploadedAt  DateTime  @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("complaint_attachments")
}

model TicketEvent {
  id          String       @id @default(uuid())
  complaintId String
  status      TicketStatus
  note        String?
  updatedById String
  timestamp   DateTime     @default(now())

  complaint   Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  updatedBy   User         @relation(fields: [updatedById], references: [id], onDelete: Cascade)

  @@map("ticket_events")
}

model AnonymousReport {
  id           String   @id @default(uuid())
  trackingCode String   @unique
  category     String
  description  String
  status       String   @default("RECEIVED")
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("anonymous_reports")
}

model CampusClub {
  id              String       @id @default(uuid())
  name            String       @unique
  category        ClubCategory @default(TECHNOLOGY)
  leadName        String
  description     String
  memberCount     Int          @default(0)
  meetingSchedule String?
  bannerGradient  String?
  tags            String[]
  recentActivities String[]
  createdAt       DateTime     @default(now())

  @@map("campus_clubs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
